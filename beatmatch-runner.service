[Unit]
Description=BeatMatch AI Host Script Runner
After=network.target

[Service]
Type=simple
User=Usuario
WorkingDirectory=/home/Usuario/beatmatch_ai_automation_hub
ExecStart=/home/Usuario/beatmatch_ai_automation_hub/venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:5000 src.host_runner:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
